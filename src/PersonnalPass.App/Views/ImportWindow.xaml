<Window x:Class="PersonnalPass.App.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importer depuis un fichier CSV"
        Width="820" Height="600" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Importer des enregistrements" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,12"
                       Text="Fichier CSV avec les colonnes Nom, Identifiant, Mot de passe (dans cet ordre, ou avec une ligne d'en-têtes). Séparateur « ; », « , » ou tabulation." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileBox" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Choisir le fichier…" Margin="8,0,0,0" Padding="14,6" Click="Browse_Click" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock x:Name="DetectedText" Style="{StaticResource HintText}" />
            <WrapPanel Margin="0,8,0,0">
                <CheckBox x:Name="HeaderCheck" Content="La première ligne contient les en-têtes" Margin="0,0,24,0"
                          Click="Header_Click" IsEnabled="False" />
                <CheckBox x:Name="SkipDuplicatesCheck" Content="Ignorer les doublons (même nom et identifiant)" IsChecked="True"
                          Margin="0,0,24,0" Click="Options_Click" />
                <CheckBox x:Name="ShowPasswordsCheck" Content="Afficher les mots de passe" Click="Options_Click" />
            </WrapPanel>
        </StackPanel>

        <DataGrid x:Name="PreviewGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" ClipboardCopyMode="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ligne" Binding="{Binding Line}" Width="Auto" />
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Identifiant" Binding="{Binding Login}" Width="2*" />
                <DataGridTextColumn Header="Mot de passe" Binding="{Binding DisplayedPassword}" Width="1.5*" />
                <DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="1.5*" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Importer" IsEnabled="False" Padding="20,8"
                    Margin="12,0,0,0" Click="Import_Click" IsDefault="True"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            <Button DockPanel.Dock="Right" Content="Annuler" IsCancel="True" Padding="20,8" />
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
