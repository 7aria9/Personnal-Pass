<Window x:Class="PersonnalPass.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnal-Pass – Récupération"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="32,28,32,28">
        <TextBlock Text="Récupérer l'accès" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                   Text="Après un changement de processeur ou un oubli du mot de passe, ouvrez le coffre avec votre fichier et votre code de récupération, puis choisissez de nouveaux identifiants." />

        <TextBlock Text="Fichier de récupération" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FileBox" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <TextBlock Text="Code de récupération" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="CodeBox" FontFamily="Consolas" CharacterCasing="Upper" />

        <Separator Margin="0,18,0,4" />

        <TextBlock Text="Nouvel identifiant" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LoginBox" />
        <TextBlock Text="Nouveau mot de passe maître" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" />
        <TextBlock Text="Confirmation" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Annuler" IsCancel="True" Padding="0,8" />
            <Button x:Name="RestoreButton" Grid.Column="2" Content="Restaurer" IsDefault="True" Padding="0,8" Click="Restore_Click"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Grid>
        <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="Hidden" />
    </StackPanel>
</Window>
