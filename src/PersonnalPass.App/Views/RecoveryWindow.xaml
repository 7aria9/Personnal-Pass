<Window x:Class="PersonnalPass.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnal-Pass – Récupération"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel>
        <Border Background="{StaticResource HeaderGradient}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Récupérer l'accès" FontSize="22" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Après un changement de processeur ou un oubli : fichier + code de récupération, puis nouveaux identifiants." />
            </StackPanel>
        </Border>

        <StackPanel Margin="28,6,28,24">
            <TextBlock Text="FICHIER DE RÉCUPÉRATION" Style="{StaticResource SectionTitle}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FileBox" IsReadOnly="True" />
                <Button Grid.Column="1" Content="📂  Parcourir…" Margin="8,0,0,0" Click="Browse_Click" />
            </Grid>

            <TextBlock Text="CODE DE RÉCUPÉRATION" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="CodeBox" FontFamily="{StaticResource MonoFont}" FontSize="15" CharacterCasing="Upper" />

            <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,4" />

            <TextBlock Text="NOUVEL IDENTIFIANT" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="LoginBox" />
            <TextBlock Text="NOUVEAU MOT DE PASSE MAÎTRE" Style="{StaticResource SectionTitle}" />
            <PasswordBox x:Name="PasswordBox" />
            <TextBlock Text="CONFIRMATION" Style="{StaticResource SectionTitle}" />
            <PasswordBox x:Name="ConfirmBox" />

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="RestoreButton" Content="Restaurer" IsDefault="True" Click="Restore_Click" MinWidth="110" />
                <Button Content="Annuler" IsCancel="True" MinWidth="96" />
            </StackPanel>
            <ProgressBar x:Name="Busy" Style="{StaticResource ThinBar}" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Hidden" />
        </StackPanel>
    </StackPanel>
</Window>
