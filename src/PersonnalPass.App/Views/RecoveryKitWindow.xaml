<Window x:Class="PersonnalPass.App.Views.RecoveryKitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnal-Pass – Kit de récupération"
        Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <StackPanel>
        <Border Background="{StaticResource HeaderGradient}" Padding="28,20">
            <StackPanel>
                <TextBlock Text="Kit de récupération" FontSize="22" FontWeight="Bold" />
                <TextBlock Foreground="{StaticResource TextDim}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="À garder précieusement : c'est la seule façon de rouvrir le coffre sur un autre processeur ou après un oubli." />
            </StackPanel>
        </Border>

        <StackPanel Margin="28,8,28,24">
            <TextBlock Style="{StaticResource HintText}" Margin="0,10,0,0">
                Il faudra <Run FontWeight="Bold" Foreground="{StaticResource Text}">les deux éléments ci-dessous</Run>.
                Gardez-les séparément : le fichier seul ou le code seul ne suffisent pas.
            </TextBlock>

            <TextBlock Text="1. FICHIER DE RÉCUPÉRATION" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="Enregistrez-le sur une clé USB ou un autre support que cet ordinateur." />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="💾  Enregistrer le fichier…" Click="SaveFile_Click" Margin="0" />
                        <TextBlock x:Name="SavedText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Success}" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="2. CODE DE RÉCUPÉRATION" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Text="Notez-le sur papier. Il n'est enregistré nulle part et ne sera plus jamais affiché." />
                    <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="SemiBold"
                             HorizontalContentAlignment="Center" Margin="0,10,0,0" Padding="6,10"
                             Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="ConfirmCheck" Margin="0,18,0,0" Checked="Update_State" Unchecked="Update_State"
                      Content="J'ai enregistré le fichier et noté le code en lieu sûr." />

            <Button x:Name="DoneButton" Content="Terminer" IsDefault="True" IsEnabled="False" Style="{StaticResource PrimaryButton}"
                    HorizontalContentAlignment="Center" Margin="0,18,0,0" Padding="0,10" Click="Done_Click" />
        </StackPanel>
    </StackPanel>
</Window>
