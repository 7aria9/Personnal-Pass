<Window x:Class="PersonnalPass.App.Views.EntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PersonnalPass.App.Views"
        Title="Nouvel enregistrement"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="Heading" Text="Nouvel enregistrement" FontSize="22" FontWeight="SemiBold" />

        <TextBlock Text="Nom" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" />

        <TextBlock Text="Identifiant" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LoginBox" />

        <TextBlock Text="Mot de passe" Style="{StaticResource FieldLabel}" />
        <views:RevealPasswordBox x:Name="PasswordField" />

        <!-- Générateur -->
        <Border Margin="0,16,0,0" Padding="16,12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="Générateur" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Generate_Click" Padding="12,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72C;" Margin="0,0,8,0" />
                            <TextBlock Text="Générer" />
                        </StackPanel>
                    </Button>
                </DockPanel>

                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="Longueur" VerticalAlignment="Center" Width="70" />
                    <TextBlock DockPanel.Dock="Right" Width="28" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0}}" />
                    <Slider x:Name="LengthSlider" Minimum="8" Maximum="32" Value="16" IsSnapToTickEnabled="True"
                            TickFrequency="1" SmallChange="1" LargeChange="4" VerticalAlignment="Center" Margin="0,0,8,0" />
                </DockPanel>

                <UniformGrid Columns="2" Margin="0,8,0,0">
                    <CheckBox x:Name="UpperCheck" Content="Majuscules (A-Z)" IsChecked="True" />
                    <CheckBox x:Name="LowerCheck" Content="Minuscules (a-z)" IsChecked="True" />
                    <CheckBox x:Name="DigitCheck" Content="Chiffres (0-9)" IsChecked="True" />
                    <CheckBox x:Name="SpecialCheck" Content="Spéciaux (!@#…)" IsChecked="True" />
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Content="Annuler" IsCancel="True" Padding="0,8" />
            <Button Grid.Column="2" Content="Enregistrer" IsDefault="True" Padding="0,8" Click="Save_Click"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Grid>
    </StackPanel>
</Window>
