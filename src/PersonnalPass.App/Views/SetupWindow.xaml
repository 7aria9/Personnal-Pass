<Window x:Class="PersonnalPass.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personnal-Pass – Création du coffre"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel Margin="32,28,32,28">
        <TextBlock Text="Bienvenue" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,8"
                   Text="Choisissez l'identifiant et le mot de passe qui protégeront votre coffre. Ils ne sont enregistrés nulle part : en cas d'oubli, seul le fichier de récupération permettra de rouvrir le coffre." />

        <TextBlock Text="Identifiant" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="LoginBox" />

        <TextBlock Text="Mot de passe maître (12 caractères minimum conseillés)" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="PasswordBox" />

        <TextBlock Text="Confirmation" Style="{StaticResource FieldLabel}" />
        <PasswordBox x:Name="ConfirmBox" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

        <Grid Margin="0,20,0,0">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" VerticalAlignment="Bottom" Visibility="Collapsed" Margin="0,0,0,-10" />
            <Button x:Name="CreateButton" Content="Créer le coffre" IsDefault="True" Padding="0,8" Click="Create_Click"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Grid>

        <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0">
            <Hyperlink Click="Import_Click">Nouvel ordinateur ? Importer un coffre existant</Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
