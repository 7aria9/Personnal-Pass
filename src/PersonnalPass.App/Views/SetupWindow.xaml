<Window x:Class="PersonnalPass.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/personnalpass.ico"
        Title="Personnal-Pass – Création du coffre"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI"
        FocusManager.FocusedElement="{Binding ElementName=LoginBox}">
    <StackPanel>
        <Border Background="{StaticResource HeaderGradient}" Padding="28,24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PERSONNAL" Style="{StaticResource BrandText}" />
                    <TextBlock Text="·PASS" Style="{StaticResource BrandText}" Foreground="{StaticResource AccentGradient}" />
                </StackPanel>
                <TextBlock Text="Bienvenue ! Créons ton coffre." Foreground="{StaticResource TextDim}" FontSize="13" />
            </StackPanel>
        </Border>

        <StackPanel Margin="28,14,28,24">
            <TextBlock Style="{StaticResource HintText}"
                       Text="Choisissez l'identifiant et le mot de passe qui protégeront votre coffre. Ils ne sont enregistrés nulle part : en cas d'oubli, seul le kit de récupération permettra de rouvrir le coffre." />

            <TextBlock Text="IDENTIFIANT" Style="{StaticResource SectionTitle}" />
            <TextBox x:Name="LoginBox" />

            <TextBlock Text="MOT DE PASSE MAÎTRE  (12 caractères minimum conseillés)" Style="{StaticResource SectionTitle}" />
            <PasswordBox x:Name="PasswordBox" />

            <TextBlock Text="CONFIRMATION" Style="{StaticResource SectionTitle}" />
            <PasswordBox x:Name="ConfirmBox" />

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" />

            <Button x:Name="CreateButton" Content="✓  Créer le coffre" IsDefault="True" Style="{StaticResource PrimaryButton}"
                    HorizontalContentAlignment="Center" Margin="0,22,0,0" Padding="0,10" Click="Create_Click" />
            <ProgressBar x:Name="Busy" Style="{StaticResource ThinBar}" IsIndeterminate="True" Margin="0,8,0,0" Visibility="Hidden" />

            <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12">
                <Hyperlink Click="Import_Click">Nouvel ordinateur ? Importer un coffre existant</Hyperlink>
            </TextBlock>
        </StackPanel>
    </StackPanel>
</Window>
