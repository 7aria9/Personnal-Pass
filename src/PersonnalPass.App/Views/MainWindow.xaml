<Window x:Class="PersonnalPass.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/personnalpass.ico"
        Title="Personnal-Pass"
        Width="1000" Height="680" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Carte d'un enregistrement -->
        <DataTemplate x:Key="EntryTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pastille avec l'initiale -->
                <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource CoverPlaceholder}">
                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" FontSize="24" FontWeight="Black"
                               Foreground="{StaticResource AccentGradient}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <!-- Tag="login" : clic droit = copie de l'identifiant -->
                    <TextBlock Tag="login" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"
                               Background="Transparent" Cursor="Hand" ToolTip="Clic droit pour copier l'identifiant">
                        <Run Text="👤 " /><Run Text="{Binding Login, Mode=OneWay}" Foreground="{StaticResource Text}" />
                    </TextBlock>
                </StackPanel>

                <!-- Tag="password" : clic droit = copie du mot de passe -->
                <Border Tag="password" Grid.Column="2" CornerRadius="10" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center"
                        Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Cursor="Hand" ToolTip="Clic droit pour copier le mot de passe">
                    <TextBlock Text="🔑  ••••••••••" FontSize="13" Foreground="{StaticResource TextDim}" />
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Click="CopyLogin_Click" ToolTip="Copier l'identifiant" Padding="8,6">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE77B;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CopyPassword_Click" ToolTip="Copier le mot de passe" Padding="8,6">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE8C8;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Edit_Click" ToolTip="Modifier" Padding="8,6">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE70F;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="Delete_Click" ToolTip="Supprimer" Padding="8,6">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74D;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- En-tête -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderGradient}" Padding="24,18,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PERSONNAL" Style="{StaticResource BrandText}" />
                        <TextBlock Text="·PASS" Style="{StaticResource BrandText}" Foreground="{StaticResource AccentGradient}" />
                    </StackPanel>
                    <TextBlock Text="Tes mots de passe, chiffrés sur ce PC" Foreground="{StaticResource TextDim}" FontSize="13" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatCount" Text="0" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="StatLabel" Text="enregistrements" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Barre d'actions -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="18,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="220" Margin="10,0,4,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" />
                        <TextBlock x:Name="SearchHint" Text="🔍  Rechercher…" Foreground="{StaticResource TextDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                    <Button Content="🔒  Verrouiller" Click="Lock_Click" ToolTip="Verrouiller le coffre (Ctrl+L)" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="＋  Ajouter" Style="{StaticResource PrimaryButton}" Click="Add_Click" ToolTip="Nouvel enregistrement (Ctrl+N)" />
                    <Button Content="✎  Modifier" Click="EditSelected_Click" />
                    <Button Content="🗑  Supprimer" Click="DeleteSelected_Click" />
                    <Button Content="⬇  Importer CSV" Click="Import_Click" ToolTip="Importer des enregistrements depuis un fichier CSV" />
                    <Button x:Name="SecurityButton" Content="•••" Style="{StaticResource GhostButton}" Click="Security_Click" ToolTip="Sécurité et sauvegardes">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔒  Verrouiller maintenant" Click="Lock_Click" />
                                <Separator />
                                <MenuItem Header="Changer l'identifiant / le mot de passe maître…" Click="ChangeCredentials_Click" />
                                <MenuItem Header="Créer un nouveau kit de récupération…" Click="NewRecoveryKit_Click" />
                                <Separator />
                                <MenuItem Header="Sauvegarder le coffre (fichier .ppv)…" Click="Backup_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Barre d'état -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center"
                           Text="Clic droit sur un identifiant ou un mot de passe pour le copier" />
                <TextBlock x:Name="StatusText" Text="Prêt." Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Liste en cartes -->
        <Grid>
            <ListBox x:Name="EntriesList" SelectionMode="Single" Background="Transparent" BorderThickness="0" Padding="18,12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     ItemTemplate="{StaticResource EntryTemplate}"
                     MouseDoubleClick="List_MouseDoubleClick" PreviewKeyDown="List_KeyDown"
                     PreviewMouseRightButtonUp="List_RightClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Card" Background="{StaticResource Surface}" CornerRadius="12" Margin="0,0,0,10"
                                            Padding="12" BorderThickness="1.5" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentGradient}" />
                                            <Setter TargetName="Card" Property="Background" Value="{StaticResource Selected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="🔑" FontSize="44" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock x:Name="EmptyText" Margin="0,12,0,0" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="14" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
