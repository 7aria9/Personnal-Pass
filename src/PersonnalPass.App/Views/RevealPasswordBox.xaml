<UserControl x:Class="PersonnalPass.App.Views.RevealPasswordBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <PasswordBox x:Name="Hidden" PasswordChanged="Hidden_PasswordChanged" FontFamily="Consolas" />
        <TextBox x:Name="Plain" Visibility="Collapsed" TextChanged="Plain_TextChanged" FontFamily="Consolas" />
        <ToggleButton x:Name="Toggle" Grid.Column="1" Margin="6,0,0,0" Padding="10,0" ToolTip="Afficher / masquer"
                      Checked="Toggle_Changed" Unchecked="Toggle_Changed">
            <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE890;" />
        </ToggleButton>
    </Grid>
</UserControl>
